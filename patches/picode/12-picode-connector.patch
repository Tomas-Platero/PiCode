+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) PiCode. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+/**
+ * Finding pi, and loading it.
+ *
+ * One place, because two modules need it for two different things: the agent needs
+ * `createAgentSession`, and connecting a subscription needs `createAgentSessionServices` to
+ * reach pi's provider catalogue and its login. A second copy of the candidate paths would be a
+ * second answer to "where is the pi of this editor", and the product only has one.
+ *
+ * pi is **not** a dependency of the editor's build: it is loaded by URL at runtime, and only
+ * the members actually used are declared structurally by each caller. That is why the load is
+ * generic here and typed by whoever asks.
+ */
+
+/** The candidate places pi can live, most-PiCode-first. */
+export function sdkCandidates(distributionRoot: string): string[] {
+	return [
+		// PiCode's own runtime, where it installs its pinned pi.
+		path.join(distributionRoot, 'resources', 'pi-runtime', 'node_modules', '@earendil-works', 'pi-coding-agent', 'dist', 'index.js'),
+		// A pi already present for this machine. Not the product's own profile — only the
+		// code — so nothing of the owner's configuration is read or written from here.
+		path.join(distributionRoot, 'resources', 'app', 'node_modules', '@earendil-works', 'pi-coding-agent', 'dist', 'index.js'),
+	];
+}
+
+/** The first candidate that is a file, or `undefined` when none is. */
+export function firstExisting(candidates: readonly string[]): string | undefined {
+	return candidates.find(candidate => {
+		try {
+			return fs.statSync(candidate).isFile();
+		} catch {
+			return false;
+		}
+	});
+}
+
+/**
+ * Loads pi's entry, or `undefined` when there is none to load or it cannot be imported.
+ *
+ * `import()` of a **built** specifier on purpose: TypeScript rewrites a literal dynamic import
+ * to `require()` when the module target is CommonJS, and pi publishes its entry as ESM that
+ * `require()` cannot load. Building the import at runtime keeps it a genuine dynamic import.
+ */
+export async function loadPiSdk<T>(distributionRoot: string): Promise<T | undefined> {
+	const entry = firstExisting(sdkCandidates(distributionRoot));
+	if (entry === undefined) {
+		return undefined;
+	}
+	try {
+		const imported = (await import(pathToFileURL(entry).href)) as T;
+		return imported;
+	} catch {
+		return undefined;
+	}
+}
