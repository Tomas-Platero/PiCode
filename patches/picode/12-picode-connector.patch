+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) PiCode. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+/**
+ * Connecting a model provider **into PiCode's own profile**.
+ *
+ * This is the owner's chosen road: PiCode's pi is the one that connects, and what it
+ * connects is kept in PiCode's own profile (`data/pi-agent`). Nothing is written to the
+ * machine's pi, ever.
+ *
+ * The flow is the editor's own dialogs — the picker, the input boxes — and this module draws
+ * nothing of its own: no panel, no tab, no settings page. The editor's chat is the surface,
+ * and this is the machinery behind it.
+ *
+ * ## Why the models are fetched instead of typed
+ *
+ * An endpoint like a router answers with its own list at `GET <baseUrl>/models`. Asking the
+ * owner to type 163 model ids by hand would be absurd, and asking them to remember which ones
+ * exist would be worse: the endpoint knows, so the endpoint is asked. If it does not answer,
+ * the flow says so and offers to write the provider anyway with no models, rather than
+ * inventing a list.
+ */
+
+export const CONNECT_PROVIDER_COMMAND = 'picode.connectProvider';
+
+/** The vendor pi and the editor both use for this product. */
+const VENDOR = 'picode';
+
+/* ------------------------------------------------------------------ *
+ * The shapes that get written
+ * ------------------------------------------------------------------ */
+
+/** One provider as pi's `models.json` declares it. */
+export interface ProviderDraft {
+	readonly id: string;
+	readonly baseUrl: string;
+	readonly api: string;
+	/**
+	 * Where the key is read from when it is not in `auth.json`.
+	 *
+	 * Left **unset** by the connect flow on purpose. pi's own documentation is explicit: "Omit
+	 * it when auth is provided by `/login`/`auth.json`" — and the key this flow collects goes
+	 * to `auth.json`, which pi consults before this field. Writing a `$NAME` here as well would
+	 * point at an environment variable nobody set, and would be read only if the credential
+	 * were missing.
+	 */
+	readonly apiKey?: string;
+	/**
+	 * Tells pi to send `Authorization: Bearer <key>`.
+	 *
+	 * Documented as the switch that makes the header appear, so a provider whose key was given
+	 * sets it: without it, pi has a credential and does not present it, and the endpoint
+	 * answers 401 while everything looks configured.
+	 */
+	readonly authHeader?: boolean;
+}
+
+/** One model as pi's `models.json` declares it. */
+export interface ModelDraft {
+	readonly id: string;
+	readonly name?: string;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+	return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/**
+ * The model ids an OpenAI-compatible endpoint answers with.
+ *
+ * Two shapes are accepted because both are found in the wild and neither is wrong: the
+ * documented `{ data: [{ id }] }` and a plain `{ models: [{ id }] }`. Anything else yields an
+ * empty list rather than a guess — a made-up model id would be a row in the editor that fails
+ * the moment it is used.
+ */
+export function parseModelIds(payload: unknown): string[] {
+	const list = isRecord(payload)
+		? Array.isArray(payload.data)
+			? payload.data
+			: Array.isArray(payload.models)
+				? payload.models
+				: undefined
+		: undefined;
+	if (list === undefined) {
+		return [];
+	}
+	const ids: string[] = [];
+	for (const entry of list) {
+		const id = typeof entry === 'string' ? entry : isRecord(entry) ? entry.id : undefined;
+		if (typeof id === 'string' && id.length > 0) {
+			ids.push(id);
+		}
+	}
+	// Sorted and deduplicated, so the file does not depend on the endpoint's mood.
+	return [...new Set(ids)].sort((left, right) => left.localeCompare(right));
+}
+
+/**
+ * `models.json` with this provider written into it, keeping every other provider.
+ *
+ * A merge and not a replacement: the owner may have several connected, and rewriting the file
+ * from one form would silently drop the rest. An existing entry for the same id is replaced,
+ * because that is what "connect this provider" means when it is already there.
+ */
+export function mergeModelsFile(existing: unknown, draft: ProviderDraft, models: readonly ModelDraft[]): Record<string, unknown> {
+	const root = isRecord(existing) ? { ...existing } : {};
+	const providers = isRecord(root.providers) ? { ...root.providers } : {};
+	providers[draft.id] = {
+		baseUrl: draft.baseUrl,
+		api: draft.api,
+		...(draft.apiKey === undefined || draft.apiKey.length === 0 ? {} : { apiKey: draft.apiKey }),
+		...(draft.authHeader === true ? { authHeader: true } : {}),
+		models: models.map(model => ({ id: model.id, ...(model.name === undefined ? {} : { name: model.name }) })),
+	};
+	root.providers = providers;
+	return root;
+}
+
+/**
+ * `auth.json` with this provider's key stored, keeping every other credential.
+ *
+ * pi's own shape for an API key: `{ "<provider>": { type: "api_key", key } }`. The key is
+ * written **here** rather than in `models.json` when the owner gave one, because that is the
+ * file pi keeps credentials in and the one it can rotate without touching the model list.
+ */
+export function authFileWith(existing: unknown, providerId: string, key: string): Record<string, unknown> {
+	const root = isRecord(existing) ? { ...existing } : {};
+	root[providerId] = { type: 'api_key', key };
+	return root;
+}
+
+/* ------------------------------------------------------------------ *
+ * Reading and writing the profile
+ * ------------------------------------------------------------------ */
+
+function readJson(file: string): unknown {
+	try {
+		return JSON.parse(fs.readFileSync(file, 'utf8'));
+	} catch {
+		// Missing or broken means "nothing there yet", which is the first run's answer and not
+		// an error worth stopping for.
+		return undefined;
+	}
+}
+
+function writeJson(file: string, value: unknown): void {
+	fs.mkdirSync(path.dirname(file), { recursive: true });
+	fs.writeFileSync(file, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 });
+}
+
+/* ------------------------------------------------------------------ *
+ * The editor's own configuration
+ * ------------------------------------------------------------------ */
+
+/**
+ * What the owner fills in, in the editor's own configuration for this provider.
+ *
+ * This is the surface the owner asked for: the fields are **declared in the contribution**
+ * and the editor renders them itself — with the key marked as a secret, so it is stored
+ * encrypted and never shown back. No dialog of ours is involved.
+ */
+export interface ProviderConfiguration {
+	readonly id?: string;
+	readonly endpoint?: string;
+	readonly api?: string;
+	readonly apiKey?: string;
+}
+
+/** The declared fields, read defensively: these values are typed by a person. */
+export function readConfiguration(raw: unknown): ProviderConfiguration {
+	if (!isRecord(raw)) {
+		return {};
+	}
+	const text = (key: string): string | undefined => {
+		const value = raw[key];
+		return typeof value === 'string' && value.trim().length > 0 ? value.trim() : undefined;
+	};
+	return {
+		...(text('id') === undefined ? {} : { id: text('id') }),
+		...(text('endpoint') === undefined ? {} : { endpoint: text('endpoint') }),
+		...(text('api') === undefined ? {} : { api: text('api') }),
+		...(text('apiKey') === undefined ? {} : { apiKey: text('apiKey') }),
+	};
+}
+
+/**
+ * The models the configured endpoint answers with, in the editor's model shape.
+ *
+ * The configured provider comes first and is the one that matters: when the endpoint is set
+ * there, the models are read from **it**. `models.json` is only consulted for the providers
+ * written by the connection command, so that path keeps working while this one replaces it.
+ */
+export async function modelsForConfiguration(config: ProviderConfiguration): Promise<vscode.LanguageModelChatInformation[]> {
+	if (config.endpoint === undefined) {
+		return [];
+	}
+	const id = config.id ?? 'pi';
+	const ids = (await fetchModelIds(config.endpoint, config.apiKey)) ?? [];
+	return ids.map(model => ({
+		id: `${id}/${model}`,
+		name: model,
+		family: id,
+		version: '1',
+		maxInputTokens: 128000,
+		maxOutputTokens: 16384,
+		detail: id,
+		capabilities: { toolCalling: true },
+	}));
+}
+
+/* ------------------------------------------------------------------ *
+ * The flow
+ * ------------------------------------------------------------------ */
+
+/** The dialects the editor can send and pi can speak; the first is the common one. */
+const DIALECTS: readonly { readonly label: string; readonly value: string }[] = [
+	{ label: 'OpenAI (compatible): the usual one', value: 'openai-completions' },
+	{ label: 'OpenAI (responses)', value: 'openai-responses' },
+	{ label: 'Anthropic (messages)', value: 'anthropic-messages' },
+	{ label: 'Google (generative AI)', value: 'google-generative-ai' },
+];
+
+/**
+ * Asks the endpoint for its own model list.
+ *
+ * A failure is returned as `undefined` and never thrown at the caller: an endpoint that does
+ * not answer is a fact to tell the owner about, not a reason to abort a connection they may
+ * still want.
+ */
+async function fetchModelIds(baseUrl: string, apiKey: string | undefined): Promise<string[] | undefined> {
+	try {
+		const response = await fetch(`${baseUrl.replace(/\/$/, '')}/models`, {
+			headers: apiKey === undefined || apiKey.length === 0 ? {} : { authorization: `Bearer ${apiKey}` },
+		});
+		if (!response.ok) {
+			return undefined;
+		}
+		return parseModelIds(await response.json());
+	} catch {
+		return undefined;
+	}
+}
+
+/**
+ * The command: connects one provider into PiCode's own profile.
+ *
+ * Every step is a dialog the editor already has, and every answer is used as given. The
+ * profile directory is passed in rather than resolved here, so there is exactly one place
+ * that decides where PiCode's profile is.
+ */
+export async function connectProvider(profileDir: string): Promise<void> {
+	const id = await vscode.window.showInputBox({
+		title: 'PiCode: connect a model provider',
+		prompt: 'A short name for this provider, with no spaces (for example `omni`).',
+		placeHolder: 'omni',
+		validateInput: value => (/^[a-z0-9][a-z0-9-]*$/i.test(value.trim()) ? undefined : 'Letters, numbers and hyphens only.'),
+	});
+	if (id === undefined || id.trim().length === 0) {
+		return;
+	}
+
+	const baseUrl = await vscode.window.showInputBox({
+		title: `PiCode: ${id.trim()}`,
+		prompt: 'The endpoint address, ending in `/v1` when the provider asks for one.',
+		placeHolder: 'https://openrouter.ai/api/v1',
+		validateInput: value => (/^https?:\/\/\S+$/.test(value.trim()) ? undefined : 'It has to start with http:// or https://'),
+	});
+	if (baseUrl === undefined || baseUrl.trim().length === 0) {
+		return;
+	}
+
+	const dialect = await vscode.window.showQuickPick([...DIALECTS], {
+		title: `PiCode: ${id.trim()}`,
+		placeHolder: 'Which dialect does this endpoint speak?',
+	});
+	if (dialect === undefined) {
+		return;
+	}
+
+	const apiKey = await vscode.window.showInputBox({
+		title: `PiCode: ${id.trim()}`,
+		prompt: 'The provider key. It is stored in PiCode\'s own profile, never outside it. Leave it empty when none is needed.',
+		password: true,
+	});
+
+	const trimmedKey = (apiKey ?? '').trim();
+	// The models are **asked of the endpoint**, never typed by hand: an endpoint that answers
+	// knows its own catalogue and the owner does not, and a hand-written list is stale the day
+	// the provider adds a model. If it does not answer, nothing is written at all — a provider
+	// saved with no models is a configuration that looks connected and can use nothing.
+	const models = await vscode.window.withProgress(
+		// Wording matters here: this is PiCode reading a list, not a form. "Asking X which models it
+		// has" was read as a question aimed at the owner, which is exactly what this flow exists to
+		// stop asking.
+		{ location: vscode.ProgressLocation.Notification, title: `PiCode: reading ${id.trim()}'s model list…` },
+		async () => fetchModelIds(baseUrl.trim(), trimmedKey === '' ? undefined : trimmedKey),
+	);
+
+	if (models === undefined) {
+		void vscode.window.showErrorMessage(
+			`PiCode: ${id.trim()} did not answer with its model list at ${baseUrl.trim().replace(/\/$/, '')}/models, so nothing was saved. ` +
+				'Check the address (many providers want it ending in `/v1`) and, when a key is needed, that it is the right one.',
+		);
+		return;
+	}
+
+	const hasKey = trimmedKey !== '';
+
+	// The provider entry, with **no `apiKey`**: pi's documentation says to omit it when the
+	// credential lives in `auth.json`, which is where the next step puts it. `authHeader` is
+	// set when there is a key, because it is the documented switch that makes pi present it.
+	const modelsFile = path.join(profileDir, 'models.json');
+	writeJson(
+		modelsFile,
+		mergeModelsFile(
+			readJson(modelsFile),
+			{
+				id: id.trim(),
+				baseUrl: baseUrl.trim(),
+				api: dialect.value,
+				...(hasKey ? { authHeader: true } : {}),
+			},
+			models.map(model => ({ id: model })),
+		),
+	);
+
+	// The key goes to `auth.json`, the file pi keeps credentials in and the one it reads before
+	// any other source. Nothing is written outside PiCode's own profile.
+	if (hasKey) {
+		const authFile = path.join(profileDir, 'auth.json');
+		writeJson(authFile, authFileWith(readJson(authFile), id.trim(), trimmedKey));
+	}
+
+	const reload = await vscode.window.showInformationMessage(
+		`PiCode: ${id.trim()} connected with ${models.length} model(s).`,
+		'Reload Window',
+	);
+	if (reload === 'Reload Window') {
+		await vscode.commands.executeCommand('workbench.action.reloadWindow');
+	}
+}
+
+/** The vendor the editor's model list groups these under. */
+export { VENDOR };
