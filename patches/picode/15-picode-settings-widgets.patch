+/**
+ * The MCP servers a settings row holds, read from the value the settings model has for it.
+ *
+ * Only rows that describe a server come through, and every field is checked rather than trusted:
+ * the value is typed by hand.
+ */
+function getMcpServerValues(element: SettingsTreeSettingElement): IMcpServerValue[] {
+	if (!Array.isArray(element.value)) {
+		return [];
+	}
+	const values: IMcpServerValue[] = [];
+	for (const entry of element.value) {
+		if (typeof entry !== 'object' || entry === null) {
+			continue;
+		}
+		const record = entry as Record<string, unknown>;
+		const name = typeof record.name === 'string' ? record.name.trim() : '';
+		const target = typeof record.target === 'string' ? record.target.trim() : '';
+		if (name.length === 0 || target.length === 0) {
+			continue;
+		}
+		values.push({
+			name,
+			transport: record.transport === 'stdio' ? 'stdio' : 'http',
+			target,
+			args: typeof record.args === 'string' ? record.args.trim() : '',
+			key: typeof record.key === 'string' ? record.key : '',
+		});
+	}
+	return values;
+}
+
+/** One row's worth of editing state, dropped: only the stored fields are kept. */
+function mcpServerValueOf(item: IMcpServerValue): IMcpServerValue {
+	return { name: item.name, transport: item.transport, target: item.target, args: item.args, key: item.key };
+}
+
+/** The list after one of the widget's events, as the value the setting is saved with. */
+function applyMcpServerListEvent(current: readonly IMcpServerValue[], event: SettingListEvent<IMcpServerDataItem>): IMcpServerValue[] {
+	const values = current.map(mcpServerValueOf);
+	switch (event.type) {
+		case 'add':
+		case 'change':
+			if (event.targetIndex >= 0 && event.targetIndex < values.length) {
+				values[event.targetIndex] = mcpServerValueOf(event.newItem);
+			} else {
+				values.push(mcpServerValueOf(event.newItem));
+			}
+			break;
+		case 'remove':
+		case 'reset':
+			values.splice(event.targetIndex, 1);
+			break;
+		case 'move': {
+			const [moved] = values.splice(event.sourceIndex, 1);
+			values.splice(event.targetIndex, 0, moved);
+			break;
+		}
+	}
+	return values;
+}
