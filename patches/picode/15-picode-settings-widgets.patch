+ * painting it as one would offer the owner a connection that cannot be made. The value is typed
+ * by hand in an editor, so every field is checked rather than trusted.
+ */
+function getProviderValues(element: SettingsTreeSettingElement): IProviderValue[] {
+	if (!Array.isArray(element.value)) {
+		return [];
+	}
+	const values: IProviderValue[] = [];
+	for (const entry of element.value) {
+		if (typeof entry !== 'object' || entry === null) {
+			continue;
+		}
+		const record = entry as Record<string, unknown>;
+		const id = typeof record.id === 'string' ? record.id.trim() : '';
+		const endpoint = typeof record.endpoint === 'string' ? record.endpoint.trim() : '';
+		if (id.length === 0 || endpoint.length === 0) {
+			continue;
+		}
+		values.push({
+			id,
+			endpoint,
+			api: typeof record.api === 'string' && record.api.length > 0 ? record.api : PROVIDER_LIST_DEFAULT_DIALECT,
+			key: typeof record.key === 'string' ? record.key : '',
+		});
+	}
