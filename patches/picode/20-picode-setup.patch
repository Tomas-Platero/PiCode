diff --git a/extensions/picode/src/onboarding.ts b/extensions/picode/src/onboarding.ts
new file mode 100644
index 00000000..14c8775d
--- /dev/null
+++ b/extensions/picode/src/onboarding.ts
@@ -0,0 +1,355 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) PiCode. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { existsSync } from 'node:fs';
+import * as path from 'node:path';
+import { execFile } from 'node:child_process';
+import * as vscode from 'vscode';
+import { externalSdkEntry } from './piLocate';
+import { PICODE_RUNTIME_SETTING, internalProfileDir, readRuntimeMode } from './runtime';
+
+/**
+ * The first-run setup: which pi runs, whether Gentle AI is on, and the theme.
+ *
+ * A flow, not a surface. It uses the editor's own quick input for its questions and the
+ * editor's own theme picker for its preview, so it adds no panel, no tab and no webview —
+ * the surfaces stay the editor's. It can be run at any time (`PiCode: Set up PiCode`, or
+ * the button on the welcome page), and the welcome page is what offers it on the first run.
+ *
+ * ## What each step writes
+ *
+ * - **pi** writes `picode.pi.runtime`. It takes effect on the next conversation, and the
+ *   running model cache is dropped so the editor asks again.
+ * - **Gentle AI** installs or removes two pi packages in **PiCode's own profile**, with pi's
+ *   own CLI. With the external pi selected the step says so and touches nothing: that
+ *   profile belongs to the machine, and nothing of PiCode's is ever written outside the
+ *   product. The state is what is installed — there is no second switch that could disagree.
+ * - **the theme** is chosen in the editor's picker (`workbench.action.selectTheme`), which
+ *   previews live; this step only reports what is in force and offers the gallery.
+ * - **the summary** records nothing but the "already set up" mark, and repeats the choices
+ *   in one screen.
+ */
+
+/** The command the welcome page and the palette call. */
+export const SETUP_COMMAND = 'picode.setup';
+
+/** The "the wizard already ran" mark, in this extension's own global state. */
+const DONE_KEY = 'picode.onboarding.done';
+
+/** How many times the gentle first-run nudge may show before it keeps quiet for good. */
+const MAX_NUDGES = 3;
+
+/** The nudge counter, so a user who answers "not now" three times is never asked again. */
+const NAG_KEY = 'picode.onboarding.nudged';
+
+/** The packages Gentle AI is made of, as pi knows them. */
+const GENTLE_PACKAGES = ['npm:gentle-pi', 'npm:gentle-engram'] as const;
+
+/** The directories an installed Gentle AI leaves inside the profile it was installed into. */
+const GENTLE_PACKAGE_DIRS = ['gentle-pi', 'gentle-engram'] as const;
+
+export interface SetupDeps {
+	/** The distribution root: where pi's CLI and the profile live. */
+	readonly distributionRoot: string;
+	/** PiCode's own profile — the write target of every choice this flow makes. */
+	readonly profileDir: string;
+	readonly globalState: vscode.Memento;
+	/** Drops the cached pi runtime, so the editor asks for models again after a pi change. */
+	readonly forgetRuntime: () => void;
+}
+
+/* ------------------------------------------------------------------ *
+ * Registration
+ * ------------------------------------------------------------------ */
+
+export function registerSetupCommand(deps: SetupDeps): vscode.Disposable {
+	return vscode.commands.registerCommand(SETUP_COMMAND, () => runSetup(deps));
+}
+
+/**
+ * The first-run nudge, shown once per start at most and at most `MAX_NUDGES` times ever.
+ *
+ * It only speaks when there is genuinely nothing configured yet — no choice made, no
+ * provider declared, no credential and no models in the profile. A working setup is never
+ * interrupted; the welcome page stays the place the setup is offered from.
+ */
+export async function maybeNudgeFirstRun(deps: SetupDeps): Promise<void> {
+	if (deps.globalState.get<boolean>(DONE_KEY) === true) {
+		return;
+	}
+	const nudges = deps.globalState.get<number>(NAG_KEY, 0);
+	if (nudges >= MAX_NUDGES) {
+		return;
+	}
+
+	const providers = vscode.workspace.getConfiguration('picode').get<unknown[]>('providers');
+	if (Array.isArray(providers) && providers.length > 0) {
+		return;
+	}
+	const profile = internalProfileDir(deps.distributionRoot);
+	if (existsSync(path.join(profile, 'auth.json')) || existsSync(path.join(profile, 'models.json'))) {
+		return;
+	}
+
+	const answer = await vscode.window.showInformationMessage(
+		'Welcome to PiCode. Set up your pi, Gentle AI and your theme?',
+		'Set up…',
+		'Not now',
+	);
+	deps.globalState.update(NAG_KEY, nudges + 1);
+	if (answer === 'Set up…') {
+		await runSetup(deps);
+	}
+}
+
+/* ------------------------------------------------------------------ *
+ * The flow
+ * ------------------------------------------------------------------ */
+
+async function runSetup(deps: SetupDeps): Promise<void> {
+	// The steps run in order and each one returns when it is done; `undefined` means the
+	// owner dismissed that step, which ends the whole flow — half an answer is not a setup.
+	const chosePi = await choosePiStep(deps);
+	if (!chosePi) { return; }
+
+	const gentleState = await gentleStep(deps);
+	if (gentleState === undefined) { return; }
+
+	const themeChosen = await themeStep();
+	if (!themeChosen) { return; }
+
+	await summaryStep(deps, gentleState);
+}
+
+type QuickPickResult<T extends vscode.QuickPickItem> = T | undefined;
+
+async function pick<T extends vscode.QuickPickItem>(
+	items: readonly T[],
+	placeholder: string,
+	title: string,
+): Promise<QuickPickResult<T>> {
+	return vscode.window.showQuickPick([...items], {
+		placeHolder: placeholder,
+		title,
+		ignoreFocusOut: true,
+	});
+}
+
+/* ------------------------------------------------------------------ *
+ * Step 1 — which pi runs
+ * ------------------------------------------------------------------ */
+
+async function choosePiStep(deps: SetupDeps): Promise<boolean> {
+	for (;;) {
+		const mode = readRuntimeMode();
+		const externalFound = externalSdkEntry() !== undefined;
+		const choice = await pick(
+			[
+				{
+					label: mode === 'internal' ? '$(check)  PiCode\'s internal pi' : 'PiCode\'s internal pi',
+					detail: 'The pi that comes with the editor, kept and updated by PiCode. Its configuration lives inside PiCode.',
+				},
+				{
+					label: mode === 'external' ? '$(check)  The pi on this machine (external)' : 'The pi on this machine (external)',
+					detail: externalFound
+						? 'Your own installation, with its own configuration. PiCode reads it and never writes to it.'
+						: 'Not found on the PATH. Install pi on this machine first, or choose the internal pi.',
+				},
+			] satisfies vscode.QuickPickItem[],
+			'Which pi runs as the editor\'s agent?',
+			'Set up PiCode · 1 of 4 — pi',
+		);
+		if (choice === undefined) {
+			return false;
+		}
+		const selected = choice.label.includes('internal') ? 'internal' : 'external';
+		if (selected === 'external' && !externalFound) {
+			// A choice that cannot run is not offered twice: the loop redraws the same step,
+			// and the detail line already says why the external one is not available.
+			continue;
+		}
+		if (selected !== mode) {
+			await vscode.workspace.getConfiguration('picode').update(PICODE_RUNTIME_SETTING, selected, vscode.ConfigurationTarget.Global);
+			// The chosen runtime decides the pi of the next conversation; the caches of the
+			// previous one are dropped so the editor asks for models again.
+			deps.forgetRuntime();
+		}
+		return true;
+	}
+}
+
+/* ------------------------------------------------------------------ *
+ * Step 2 — Gentle AI
+ * ------------------------------------------------------------------ */
+
+type GentleState = 'on' | 'off' | 'external';
+
+/** Whether Gentle AI is installed in the given profile. */
+export function isGentleInstalled(profileDir: string): boolean {
+	return GENTLE_PACKAGE_DIRS.every(dir => existsSync(path.join(profileDir, 'npm', 'node_modules', dir)));
+}
+
+async function gentleStep(deps: SetupDeps): Promise<GentleState | undefined> {
+	const external = readRuntimeMode() === 'external';
+	const installed = isGentleInstalled(deps.profileDir);
+
+	if (external) {
+		// The external pi's profile is the machine's: the packages there are installed and
+		// removed from a terminal, not from this editor.
+		const choice = await pick(
+			[{
+				label: 'Continue',
+				detail: 'Gentle AI lives in the external pi\'s own profile, which this editor never writes to. '
+					+ 'To add or remove it, run `pi install npm:gentle-pi npm:gentle-engram` (or `pi remove …`) from a terminal.',
+			}] satisfies vscode.QuickPickItem[],
+			'Gentle AI belongs to the pi you chose.',
+			'Set up PiCode · 2 of 4 — Gentle AI',
+		);
+		return choice === undefined ? undefined : 'external';
+	}
+
+	const state = installed
+		? 'Gentle AI is installed: agents, skills and memory are part of your pi.'
+		: 'Gentle AI is not installed: pi runs plain, with no extra agents, skills or memory.';
+	const choice = await pick(
+		[
+			{
+				label: installed ? '$(check)  Keep Gentle AI on' : 'Install Gentle AI',
+				detail: 'The agent layer: ODD, subagents, skills and persistent memory, installed into PiCode\'s own profile.',
+			},
+			{
+				label: installed ? 'Remove Gentle AI' : '$(check)  Use pi without Gentle AI',
+				detail: 'Plain pi: no gentle agents, no skills, no memory. Everything else keeps working.',
+			},
+		] satisfies vscode.QuickPickItem[],
+		state,
+		'Set up PiCode · 2 of 4 — Gentle AI',
+	);
+	if (choice === undefined) {
+		return undefined;
+	}
+
+	const wantOn = choice.label.includes('Gentle AI on') || choice.label.includes('Install Gentle AI');
+	if (wantOn === installed) {
+		return wantOn ? 'on' : 'off';
+	}
+
+	await vscode.window.withProgress(
+		{ location: vscode.ProgressLocation.Notification, title: wantOn ? 'Installing Gentle AI…' : 'Removing Gentle AI…' },
+		() => runPiCli(deps.distributionRoot, [wantOn ? 'install' : 'remove', ...GENTLE_PACKAGES], deps.profileDir),
+	);
+	void vscode.window.showInformationMessage(
+		wantOn
+			? 'Gentle AI is installed for pi. Its agents and skills are available in new conversations.'
+			: 'Gentle AI was removed from pi\'s configuration. New conversations run plain pi.',
+	);
+	return wantOn ? 'on' : 'off';
+}
+
+/* ------------------------------------------------------------------ *
+ * Step 3 — the theme
+ * ------------------------------------------------------------------ */
+
+async function themeStep(): Promise<boolean> {
+	for (;;) {
+		const current = vscode.workspace.getConfiguration('workbench').get<string>('colorTheme') ?? '(default)';
+		const choice = await pick(
+			[
+				{
+					label: 'Choose a theme…',
+					detail: 'The editor\'s own picker: the preview follows as you move through the list.',
+				},
+				{
+					label: 'Browse more themes…',
+					detail: 'Theme extensions from the gallery, installed straight from the search.',
+				},
+				{
+					label: 'Continue',
+					detail: `Keep the theme in force: ${current}`,
+				},
+			] satisfies vscode.QuickPickItem[],
+			'Pick the colors you will work in.',
+			'Set up PiCode · 3 of 4 — theme',
+		);
+		if (choice === undefined) {
+			return false;
+		}
+		if (choice.label.startsWith('Continue')) {
+			return true;
+		}
+		if (choice.label.startsWith('Browse')) {
+			await vscode.commands.executeCommand('workbench.extensions.search', '@category:themes @sort:installs');
+			continue;
+		}
+		// The picker applies the theme the moment it is chosen; when the command returns the
+		// step redraws with the theme now in force.
+		await vscode.commands.executeCommand('workbench.action.selectTheme');
+	}
+}
+
+/* ------------------------------------------------------------------ *
+ * Step 4 — the summary
+ * ------------------------------------------------------------------ */
+
+async function summaryStep(deps: SetupDeps, gentle: GentleState): Promise<void> {
+	const pi = readRuntimeMode() === 'external' ? 'The pi on this machine (external)' : 'PiCode\'s internal pi';
+	const theme = vscode.workspace.getConfiguration('workbench').get<string>('colorTheme') ?? '(default)';
+	const gentleLine = gentle === 'external'
+		? 'Managed by your external pi'
+		: gentle === 'on' ? 'On (installed in PiCode\'s profile)' : 'Off — plain pi';
+
+	const choice = await pick(
+		[
+			{ label: '$(check)  Done', detail: 'Your choices are saved. You can change any of them later from Settings > Chat, or by running this again.' },
+			{ label: `pi: ${pi}` },
+			{ label: `Gentle AI: ${gentleLine}` },
+			{ label: `Theme: ${theme}` },
+		] satisfies vscode.QuickPickItem[],
+		'This is how your PiCode is set up.',
+		'Set up PiCode · 4 of 4 — summary',
+	);
+	if (choice !== undefined) {
+		deps.globalState.update(DONE_KEY, true);
+	}
+}
+
+/* ------------------------------------------------------------------ *
+ * pi's CLI
+ * ------------------------------------------------------------------ */
+
+/**
+ * Runs one pi CLI command against PiCode's own profile.
+ *
+ * The CLI is the pinned pi's own entry, run with the editor's binary in Node mode
+ * (`ELECTRON_RUN_AS_NODE`): the extension host's `process.execPath` is the Electron
+ * executable, and without the flag it would try to open an app instead of running a script.
+ * `PI_CODING_AGENT_DIR` points the command at PiCode's profile, so the packages are
+ * installed where the product can see them and nowhere else.
+ */
+export function runPiCli(distributionRoot: string, args: readonly string[], profileDir: string): Promise<void> {
+	const entry = path.join(distributionRoot, 'resources', 'pi-runtime', 'node_modules', '@earendil-works', 'pi-coding-agent', 'dist', 'cli.js');
+	if (!existsSync(entry)) {
+		void vscode.window.showErrorMessage('PiCode: pi\'s own command line is not in this editor, so this change cannot be applied from here.');
+		return Promise.resolve();
+	}
+	return new Promise<void>(resolve => {
+		execFile(
+			process.execPath,
+			[entry, ...args],
+			{
+				env: { ...process.env, ELECTRON_RUN_AS_NODE: '1', PI_CODING_AGENT_DIR: profileDir },
+				windowsHide: true,
+			},
+			error => {
+				if (error !== null) {
+					void vscode.window.showErrorMessage(`PiCode: pi's command line failed (${error.message}). The change may not have been applied.`);
+				}
+				// A failed install is reported, not retried: the step that follows reads what is
+				// actually installed, so the summary never shows a state that is not true.
+				resolve();
+			},
+		);
+	});
+}
