{
  "name": "picode-pi-chat",
  "displayName": "PiCode: pi Agent",
  "description": "PiCode agent layer: spawns the pi coding agent in RPC mode and renders a streaming chat panel.",
  "publisher": "picode",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomasPlatero/PiCode.git",
    "directory": "extensions/picode-pi-chat"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:picode.piChat",
    "onView:picode.ajustes"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "picode-ajustes",
          "title": "PiCode",
          "icon": "media/picode.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "picode",
          "title": "PiCode",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "picode": [
        {
          "id": "picode.piChat",
          "name": "agente pi",
          "type": "webview"
        }
      ],
      "picode-ajustes": [
        {
          "id": "picode.ajustes",
          "name": "Ajustes de pi",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "picode.piChat.open",
        "title": "PiCode: Abrir el chat de pi",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.newSession",
        "title": "PiCode: Nueva sesión de pi",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.abort",
        "title": "PiCode: Detener la ejecución",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.restart",
        "title": "PiCode: Reiniciar el proceso de pi",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.selectRuntime",
        "title": "PiCode: Elegir qué pi se ejecuta",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.selectTransport",
        "title": "PiCode: Elegir cómo habla con pi",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.selectModel",
        "title": "PiCode: Elegir modelo",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.selectThinkingLevel",
        "title": "PiCode: Elegir nivel de razonamiento",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.menu",
        "title": "PiCode: Abrir el menú de pi",
        "category": "PiCode",
        "icon": "$(hubot)"
      },
      {
        "command": "picode.piChat.menu.installed",
        "title": "PiCode: Extensiones instaladas",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.menu.search",
        "title": "PiCode: Buscar e instalar extensiones",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.menu.update",
        "title": "PiCode: Actualizar extensiones",
        "category": "PiCode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "picode.piChat.menu",
          "group": "navigation@1",
          "when": "view == picode.piChat"
        }
      ]
    },
    "configuration": {
      "title": "PiCode",
      "properties": {
        "picode.pi.runtime": {
          "type": "string",
          "enum": [
            "path",
            "managed",
            "custom"
          ],
          "enumDescriptions": [
            "Ejecuta el pi que encuentre en el PATH: tu instalación propia.",
            "Ejecuta el pi propio de PiCode, con versión fijada, instalado dentro de la distribución y aislado del global.",
            "Ejecuta el fichero indicado en picode.pi.executablePath tal cual."
          ],
          "default": "path",
          "markdownDescription": "Qué pi ejecuta PiCode. Se cambia desde el control de runtime del panel o con el comando **PiCode: Elegir qué pi se ejecuta**.",
          "scope": "window"
        },
        "picode.pi.executablePath": {
          "type": "string",
          "default": "pi",
          "description": "Ejecutable usado cuando picode.pi.runtime es `path` o `custom`. Un nombre suelto se resuelve en el PATH; en Windows un shim `.cmd` se lanza a través del shell del sistema.",
          "scope": "window"
        },
        "picode.pi.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Modelo aplicado a las sesiones nuevas, como `proveedor/modelo`. Vacío mantiene el modelo que pi ya tenga configurado."
        },
        "picode.pi.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Argumentos adicionales añadidos a `pi --mode rpc`."
        },
        "picode.pi.transport": {
          "type": "string",
          "enum": ["rpc", "embedded"],
          "enumDescriptions": [
            "Ejecuta `pi --mode rpc` como proceso aparte y se comunica por JSON en stdio.",
            "Carga el mismo pi dentro de la extensión con su SDK: sin proceso hijo, y las extensiones de pi pueden dibujar su propia interfaz."
          ],
          "default": "rpc",
          "description": "Cómo se comunica PiCode con pi. El transporte embebido usa la misma instalación que el de RPC.",
          "scope": "window"
        },
        "picode.context.attach": {
          "type": "boolean",
          "default": false,
          "description": "Adjuntar el contexto del editor (carpeta abierta, archivo activo, selección y problemas) a cada mensaje. El panel lo puede cambiar por sesión con el chip Contexto.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/runtime.test.js && node test/panel-dom.test.js && node test/pi-list.test.js && node test/menu-rows.test.js && node test/pi-sdk-protocol.test.js && node test/markdown.test.js",
    "test:live": "node test/rpc.live.js",
    "test:sdk": "npm run compile && node test/sdk.live.js",
    "vscode:prepublish": "npm run compile",
    "test:install": "node test/install.live.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
