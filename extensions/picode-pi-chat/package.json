{
  "name": "picode-pi-chat",
  "displayName": "PiCode: pi Agent",
  "description": "PiCode agent layer: spawns the pi coding agent in RPC mode and renders a streaming chat panel.",
  "publisher": "picode",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomasPlatero/PiCode.git",
    "directory": "extensions/picode-pi-chat"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:picode.piChat"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "picode",
          "title": "PiCode",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "picode": [
        {
          "id": "picode.piChat",
          "name": "pi agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "picode.piChat.open",
        "title": "PiCode: Open pi Chat",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.newSession",
        "title": "PiCode: New pi Session",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.abort",
        "title": "PiCode: Abort pi Run",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.restart",
        "title": "PiCode: Restart pi Process",
        "category": "PiCode"
      },
      {
        "command": "picode.piChat.selectRuntime",
        "title": "PiCode: Select pi Runtime",
        "category": "PiCode"
      }
    ],
    "configuration": {
      "title": "PiCode",
      "properties": {
        "picode.pi.runtime": {
          "type": "string",
          "enum": [
            "path",
            "managed",
            "custom"
          ],
          "enumDescriptions": [
            "Run the pi found on PATH: your own installation.",
            "Run PiCode's own pinned pi, installed inside the distribution and isolated from your global one.",
            "Run the executable given by picode.pi.executablePath exactly as written."
          ],
          "default": "path",
          "markdownDescription": "Which pi PiCode runs. Change it from the panel's runtime control or with the **PiCode: Select pi Runtime** command.",
          "scope": "window"
        },
        "picode.pi.executablePath": {
          "type": "string",
          "default": "pi",
          "description": "Executable used when picode.pi.runtime is `path` or `custom`. A bare name is resolved on PATH; on Windows a `.cmd` shim is launched through the system shell.",
          "scope": "window"
        },
        "picode.pi.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model applied to new sessions, as `provider/model-id`. Empty keeps the model pi already has configured."
        },
        "picode.pi.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments appended to `pi --mode rpc`."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node test/runtime.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
