{
	"name": "picode",
	"publisher": "picode",
	"displayName": "PiCode",
	"description": "The bridge between the editor and pi: providers, models and the agent's own runtime.",
	"version": "1.0.0",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"enabledApiProposals": [
		"chatSessionsProvider",
		"defaultChatParticipant",
		"chatProvider",
		"chatPromptFiles",
		"chatReferenceBinaryData",
		"chatParticipantAdditions",
		"chatParticipantPrivate",
		"languageModelThinkingPart",
		"languageModelPricing",
		"chatSessionCustomizationProvider"
	],
	"activationEvents": [
		"onLanguageModelChatProvider:picode",
		"onChatParticipant:picode.pi",
		"onCustomAgentProvider",
		"onSkillProvider",
		"onMcpCollection:pi",
		"onCommand:picode.setup.gallerySearch",
		"onCommand:picode.setup.galleryThumb",
		"onCommand:picode.setup.galleryInstall",
		"onStartupFinished"
	],
	"contributes": {
		"configurationDefaults": {
			"workbench.colorTheme": "Abyss"
		},
		"chatParticipants": [
			{
				"id": "picode.pi",
				"name": "picode",
				"fullName": "PiCode",
				"description": "%chatParticipant.description%",
				"isDefault": true,
				"modes": [
					"ask",
					"agent",
					"edit"
				]
			}
		],
		"mcpServerDefinitionProviders": [
			{
				"id": "pi",
				"label": "pi"
			}
		],
		"languageModelChatProviders": [
			{
				"vendor": "picode",
				"displayName": "pi",
				"configuration": {
					"properties": {
						"endpoint": {
							"type": "string",
							"description": "%provider.endpoint.description%"
						},
						"api": {
							"type": "string",
							"enum": [
								"openai-completions",
								"openai-responses",
								"anthropic-messages",
								"google-generative-ai"
							],
							"enumItemLabels": [
								"%provider.api.openai%",
								"%provider.api.responses%",
								"%provider.api.anthropic%",
								"%provider.api.google%"
							],
							"enumDescriptions": [
								"%provider.api.openaiHint%",
								"%provider.api.responsesHint%",
								"%provider.api.anthropicHint%",
								"%provider.api.googleHint%"
							],
							"default": "openai-completions",
							"description": "%provider.api.description%"
						},
						"apiKey": {
							"type": "string",
							"secret": true,
							"description": "%provider.apiKey.description%"
						},
						"id": {
							"type": "string",
							"description": "%provider.id.description%"
						}
					}
				}
			}
		],
		"commands": [
			{
				"command": "picode.agents.chooseModels",
				"title": "%command.agents.chooseModels%",
				"category": "PiCode"
			},
			{
				"command": "picode.pi.toggleThinking",
				"title": "%command.pi.toggleThinking%",
				"category": "PiCode"
			},
			{
				"command": "picode.pi.restart",
				"title": "%command.pi.restart%",
				"category": "PiCode",
				"icon": "$(refresh)"
			},
			{
				"command": "picode.pi.cleanCache",
				"title": "%command.pi.cleanCache%",
				"category": "PiCode",
				"icon": "$(trash)"
			},
			{
				"command": "picode.pi.openProfile",
				"title": "%command.pi.openProfile%",
				"category": "PiCode",
				"icon": "$(folder-opened)"
			},
			{
				"command": "picode.compareModels",
				"title": "%command.compareModels%",
				"category": "PiCode",
				"icon": "$(diff-multiple)"
			},
			{
				"command": "picode.cancelQueuedTurns",
				"title": "%command.cancelQueuedTurns%",
				"category": "PiCode"
			},
			{
				"command": "picode.status.openProviderSettings",
				"title": "%command.status.openProviderSettings%",
				"category": "PiCode",
				"icon": "$(gear)"
			},
			{
				"command": "picode.updates.apply",
				"title": "%command.updates.apply%",
				"category": "PiCode"
			},
			{
				"command": "picode.updates.check",
				"title": "%command.updates.check%",
				"category": "PiCode"
			},
			{
				"command": "picode.agents",
				"title": "%command.agents%",
				"category": "PiCode"
			},
			{
				"command": "picode.connectProvider",
				"title": "%command.connectProvider%",
				"category": "PiCode"
			},
			{
				"command": "picode.setup",
				"title": "%command.setup%",
				"category": "PiCode"
			},
			{
				"command": "picode.memory.search",
				"title": "%command.memory.search%",
				"category": "PiCode",
				"icon": "$(search)"
			},
			{
				"command": "picode.memory.clearSearch",
				"title": "%command.memory.clearSearch%",
				"category": "PiCode",
				"icon": "$(close)"
			},
			{
				"command": "picode.memory.refresh",
				"title": "%command.memory.refresh%",
				"category": "PiCode",
				"icon": "$(refresh)"
			},
			{
				"command": "picode.memory.check",
				"title": "%command.memory.check%",
				"category": "PiCode"
			},
			{
				"command": "picode.memory.copy",
				"title": "%command.memory.copy%",
				"category": "PiCode",
				"icon": "$(copy)"
			},
			{
				"command": "picode.memory.delete",
				"title": "%command.memory.delete%",
				"category": "PiCode",
				"icon": "$(trash)"
			},
			{
				"command": "picode.memory.open",
				"title": "%command.memory.open%",
				"category": "PiCode"
			},
			{
				"command": "picode.memory.showMore",
				"title": "%command.memory.showMore%",
				"category": "PiCode"
			},
			{
				"command": "picode.updates.show",
				"title": "%command.updates.show%",
				"category": "PiCode"
			},
			{
				"command": "picode.backupSessions",
				"title": "%command.backupSessions%",
				"category": "PiCode"
			},
			{
				"command": "picode.restoreSessions",
				"title": "%command.restoreSessions%",
				"category": "PiCode"
			},
			{
				"command": "picode.importExternalSessions",
				"title": "%command.importExternalSessions%",
				"category": "PiCode"
			},
			{
				"command": "picode.setup.gallerySearch",
				"title": "%command.setup.gallerySearch%",
				"category": "PiCode"
			},
			{
				"command": "picode.setup.galleryThumb",
				"title": "%command.setup.galleryThumb%",
				"category": "PiCode"
			},
			{
				"command": "picode.setup.galleryInstall",
				"title": "%command.setup.galleryInstall%",
				"category": "PiCode"
			},
			{
				"command": "picode.memory.updateEngine",
				"title": "%command.memory.updateEngine%",
				"category": "PiCode",
				"icon": "$(cloud-download)"
			},
			{
				"command": "picode.tasks.openTranscript",
				"title": "%command.tasks.openTranscript%",
				"category": "PiCode",
				"icon": "$(book)"
			},
			{
				"command": "picode.tasks.refresh",
				"title": "%command.tasks.refresh%",
				"category": "PiCode",
				"icon": "$(refresh)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "picode.tasks.refresh",
					"when": "view == picode.status.tasks",
					"group": "navigation"
				},
				{
					"command": "picode.memory.updateEngine",
					"when": "view == picode.status.memory",
					"group": "navigation"
				},
				{
					"command": "picode.memory.search",
					"when": "view == picode.status.memory && !picode.memory.searchActive",
					"group": "navigation"
				},
				{
					"command": "picode.memory.clearSearch",
					"when": "view == picode.status.memory && picode.memory.searchActive",
					"group": "navigation"
				},
				{
					"command": "picode.memory.refresh",
					"when": "view == picode.status.memory",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "picode.tasks.openTranscript",
					"when": "view == picode.status.tasks && viewItem == picode.tasks.agent",
					"group": "inline"
				},
				{
					"command": "picode.tasks.openTranscript",
					"when": "view == picode.status.tasks && viewItem == picode.tasks.agent",
					"group": "navigation"
				},
				{
					"command": "picode.memory.copy",
					"when": "view == picode.status.memory && viewItem == picode.memory.row",
					"group": "inline@1"
				},
				{
					"command": "picode.memory.delete",
					"when": "view == picode.status.memory && viewItem == picode.memory.row",
					"group": "inline@2"
				}
			],
			"commandPalette": [
				{
					"command": "picode.tasks.openTranscript",
					"when": "false"
				},
				{
					"command": "picode.memory.open",
					"when": "false"
				},
				{
					"command": "picode.memory.showMore",
					"when": "false"
				},
				{
					"command": "picode.memory.copy",
					"when": "false"
				},
				{
					"command": "picode.memory.delete",
					"when": "false"
				},
				{
					"command": "picode.setup.gallerySearch",
					"when": "false"
				},
				{
					"command": "picode.setup.galleryThumb",
					"when": "false"
				},
				{
					"command": "picode.setup.galleryInstall",
					"when": "false"
				},
				{
					"command": "picode.memory.updateEngine",
					"when": "false"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "picode-status",
					"title": "PiCode",
					"icon": "media/picode-activity.svg"
				}
			]
		},
		"views": {
			"picode-status": [
				{
					"type": "tree",
					"id": "picode.status.tasks",
					"name": "%view.tasks%",
					"icon": "$(tasklist)",
					"when": "!config.chat.disableAIFeatures && config.picode.appearance.layout != agent"
				},
				{
					"type": "tree",
					"id": "picode.status.memory",
					"name": "%view.memory%",
					"icon": "$(database)",
					"when": "picode.memory.enabled && !config.chat.disableAIFeatures && config.picode.appearance.layout != agent"
				}
			]
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:picode",
		"watch": "gulp watch-extension:picode"
	},
	"devDependencies": {
		"@types/node": "24.x"
	}
}
