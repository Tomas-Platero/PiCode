disturl="https://electronjs.org/headers"
target="42.8.1"
ms_build_id="14906494"
runtime="electron"
ignore-scripts=false
build_from_source="true"
build_from_source_native_keymap="no"
legacy-peer-deps="true"
timeout=180000
# The keys above are Electron/node-gyp's, and npm announces every one of them as unknown on
# every invocation -- seven lines before anything this project prints. Errors still reach the
# terminal; the warnings about these keys are the only thing this hides.
loglevel=error
