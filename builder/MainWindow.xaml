<Window
    x:Class="PiCode.Builder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PiCode Builder">

    <!-- No colours and no theme of our own: WinUI follows Windows, including its accent colour, which
         is what makes this look native on any machine instead of looking like this one. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <NavigationView Grid.Row="0" Name="Nav" PaneDisplayMode="Left" OpenPaneLength="210"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="OnNavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="System Check" Tag="check">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Build Logs" Tag="logs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="20" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- The pages. One is on screen at a time; the column on the right is shared, so the
                     same control never has to exist twice. -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel Name="PageHome" Spacing="14">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Name="Logo" Width="52" Height="52" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="PiCode Builder" Style="{StaticResource TitleTextBlockStyle}"/>
                                        <TextBlock Name="HeroLine" Style="{StaticResource BodyTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Name="BuildingCard" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ProgressRing Name="BusyRing" IsActive="True" Width="20" Height="20"/>
                                            <TextBlock Name="BuildHeadline" Text="Building PiCode" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Name="Percent" Text="0%" Style="{StaticResource TitleTextBlockStyle}"/>
                                    </Grid>
                                    <ProgressBar Name="Bar" Minimum="0" Maximum="100"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Name="StageLine" TextWrapping="Wrap"/>
                                            <TextBlock Name="Timing" Opacity="0.75" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Name="StopButton" VerticalAlignment="Center" Click="OnStop">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE71A;" FontSize="12"/>
                                                <TextBlock Text="Stop build"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71D;" FontSize="14"/>
                                <TextBlock Text="Build steps" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                                    <StackPanel Name="Steps" Spacing="0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Name="PageCheck" Spacing="14" Visibility="Collapsed">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="System Check" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <StackPanel Name="Checks" Spacing="10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Name="PageLogs" Spacing="14" Visibility="Collapsed">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Build Logs" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBox Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                             FontFamily="Consolas" FontSize="12" Height="460"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Name="PageSettings" Spacing="14" Visibility="Collapsed">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock Text="Where the build runs" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Name="TargetLine" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Name="ArchitectureLine" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Name="WslLine" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- The rail: what machine, whether it can be built, what happened last, and the one
                     button that does the work. -->
                <Grid Grid.Column="1" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14"/>
                                <TextBlock Text="Build target" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Windows' icon font has a desktop and a server; it has no Windows logo
                                     and no Tux. The four panes are drawn, which is unmistakable, and the
                                     server is the closest the font comes for the other side. -->
                                <Button Grid.Column="0" Name="TargetWindowsButton" Tag="windows"
                                        HorizontalAlignment="Stretch" Click="OnTargetClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Width="13" Height="13" Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                              Data="M0,0 H6 V6 H0 Z M7,0 H13 V6 H7 Z M0,7 H6 V13 H0 Z M7,7 H13 V13 H7 Z"/>
                                        <TextBlock Text="Windows"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Name="TargetLinuxButton" Tag="linux"
                                        HorizontalAlignment="Stretch" Click="OnTargetClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEC4E;" FontSize="14"/>
                                        <TextBlock Text="Linux (WSL)"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Name="RailArchitecture" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                                    <TextBlock Text="System Check" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Name="RailCheckCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <StackPanel Name="RailChecks" Spacing="8"/>
                            <Border Name="RailCheckSummary" CornerRadius="6" Padding="10" Visibility="Collapsed"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                <TextBlock Name="RailCheckSummaryText" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                <TextBlock Text="Last Build" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <StackPanel Name="LastBuild" Spacing="4"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="1" Name="BuildButton" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Height="42" Click="OnBuild">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Name="BuildButtonText" Text="Build PiCode"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </NavigationView>

        <Border Grid.Row="1" Padding="20,8" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Name="FooterVersion" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Name="FooterPath" Margin="24,0" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Name="FooterTarget"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Windows stopped drawing the resize grip years ago and this window follows Windows, so the
             corner would be empty. It is drawn back in the corner of the window itself - over the
             footer's padding, not inside it - and it is not decoration: pressing it hands the drag to
             the system, which resizes the window as it always did. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Name="GripArea" Width="16" Height="16"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" ToolTipService.ToolTip="Drag to resize">
            <Path Name="Grip" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1"
                  Opacity="0.8" Stretch="None" Data="M 13,3 L 3,13 M 13,7 L 7,13 M 13,11 L 11,13"/>
        </Border>
    </Grid>
</Window>
